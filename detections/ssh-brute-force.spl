index=security "Failed password"
| rex "from (?<src_ip>\d+\.\d+\.\d+\.\d+)"
| rex "for (?:invalid user )?(?<username>\S+) from"
| stats count AS failed_attempts earliest(_time) AS first_seen latest(_time) AS last_seen by src_ip username
| where failed_attempts >= 5
| convert ctime(first_seen) ctime(last_seen)
| sort - failed_attempts
